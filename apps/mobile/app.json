{
  "expo": {
    "name": "Dukaan360",
    "slug": "dukaan360",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dukaan360",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dukaan360.app"
    },
    "android": {
      "package": "com.dukaan360.app",
      "adaptiveIcon": {
        "backgroundColor": "#059669"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-camera", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
